# Copy this file to `.env.local` and fill in your values.
# `.env.local` is git-ignored and should never be committed.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend WebSocket endpoint for the live audit session.
# Local dev:        ws://localhost:8000/ws
# Secure tunnel:    wss://your-ngrok-subdomain.ngrok-free.dev/ws
# Production:       wss://your-backend.onrender.com/ws
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000/ws
